APP_ID=change-me-app-id
APP_KEY=change-me-generate-a-random-secret-with-openssl-rand-base64-32
APP_NAME=template
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/DATABASE_NAME?schema=template"
PORT=3001

BASE_URL=http://localhost:3001
FRONT_URL=http://localhost:3000
AUTH_SERVICE_URL=http://localhost:3002
AUTH_SERVICE_BACK_URL=http://localhost:3003

# Обязательно задайте собственные значения (без них вход администратора отключён)
ADMIN_LOGIN=change-me-admin-login
ADMIN_PASSWORD=change-me-strong-password
# --- Деплой на Amvera ---
# PORT назначается платформой автоматически (в коде читается process.env.PORT).
# FRONT_URL: список origin'ов через запятую или '*' (при раздаче SPA тем же
# приложением, как настроено в amvera.yml, можно оставить '*').
# DATABASE_URL: строка подключения к PostgreSQL из панели Amvera (База данных → PostgreSQL).
