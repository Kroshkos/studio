generator client {
  provider = "prisma-client-js"
  // provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  email    String    @unique
  password String
  personId Int?
  role     UserRole? @relation(fields: [roleName], references: [name])
  roleName String?
}

model UserRole {
  id    Int    @id @default(autoincrement())
  name  String @unique @map("v0")
  users User[]
}

model CasbinRule {
  id    Int     @id @default(autoincrement())
  ptype String
  v0    String?
  v1    String?
  v2    String?
  v3    String?
  v4    String?
  v5    String?

  @@map("casbin_rule")
}

enum BookingStage {
  AWAITING_RECORD // Ожидает записи (забронирована дата)
  RECORDING       // Запись видео
  PROCESSING      // Обработка видео
  SENT            // Видео отправлено пользователю
}

model Department {
  id           String    @id @default(cuid())
  name         String    @unique
  passwordHash String
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  bookings     Booking[]
}

model Booking {
  id             String       @id @default(cuid())
  departmentId   String
  department     Department   @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  phone          String
  email          String
  purpose        String?
  role           String // "teacher" | "student"
  date           String // YYYY-MM-DD
  slot           String // "09:00"
  dateLabel      String?
  stage          BookingStage @default(AWAITING_RECORD)
  stageUpdatedAt DateTime     @default(now())
  stageHistory   Json         @default("[]")
  createdAt      DateTime     @default(now())

  @@index([departmentId])
  @@index([date, slot])
}

model StudioConfig {
  id            Int       @id @default(1) // всегда одна запись
  blockedDays   Int[]                      // массив дней недели (1=Пн … 5=Пт) — устарело, см. dayBlocks
  msgTeacher    String
  msgStudent    String
  openTime      String    @default("09:00") // начало графика работы
  closeTime     String    @default("17:00") // конец графика работы
  slotDuration  Int       @default(60)      // длительность слота по умолчанию, мин
  dayBlocks     DayBlock[]
  timeOverrides TimeOverride[]
  updatedAt     DateTime  @updatedAt
}

// Блокировка студии: для кого (преподаватель / студент / все) и на какой промежуток
// (даты + время; если timeFrom/timeTo пустые — блокировка на весь день)
model DayBlock {
  id        Int      @id @default(autoincrement())
  configId  Int
  config    StudioConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  audience  String   // "teacher" | "student" | "all"
  dateFrom  String   // YYYY-MM-DD
  dateTo    String   // YYYY-MM-DD
  timeFrom  String?  // HH:mm (необязательно — с этого времени)
  timeTo    String?  // HH:mm (необязательно — до этого времени)
  createdAt DateTime @default(now())

  @@index([configId])
}

// Индивидуальные изменения конкретных слотов: перенос времени, изменение длительности, удаление
model TimeOverride {
  id         Int      @id @default(autoincrement())
  configId   Int
  config     StudioConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  original   String   // исходное время слота из генератора, "HH:mm"
  newTime    String?  // новое время слота (если изменено), "HH:mm"
  duration   Int?     // индивидуальная длительность в минутах (если изменена)
  deleted    Boolean  @default(false) // слот удалён
  createdAt  DateTime @default(now())

  @@unique([configId, original])
  @@index([configId])
}